{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "secure-centric/form-embed",
    "version": "1.0.0",
    "title": "Forminator Lead Capture Embed",
    "category": "secure-centric-cta",
    "icon": "feedback",
    "description": "Embeds Forminator dual-email lead capture form with instant failover fallback.",
    "keywords": [
        "form",
        "forminator",
        "lead",
        "contact",
        "defense"
    ],
    "textdomain": "secure-centric",
    "attributes": {
        "layout": {
            "type": "string",
            "default": "card"
        },
        "infoEyebrow": {
            "type": "string",
            "default": "// DIRECT ENGAGEMENT"
        },
        "infoTitle": {
            "type": "string",
            "default": "Direct Access to Registered Practitioners"
        },
        "infoDesc": {
            "type": "string",
            "default": "Every discovery call is led directly by an accredited Cyber AB Registered Practitioner (RP), not a generalist salesperson. We review your contract's DFARS 252.204-7012 clauses and help determine your exact scoping boundaries."
        },
        "phone": {
            "type": "string",
            "default": "(323) 410-5941"
        },
        "email": {
            "type": "string",
            "default": "info@secure-centric.com"
        },
        "location": {
            "type": "string",
            "default": "Los Angeles, California · Nationwide On-Site Deployments"
        },
        "formId": {
            "type": "string",
            "default": ""
        },
        "badgeText": {
            "type": "string",
            "default": "BILATERAL NDA GUARANTEE"
        },
        "title": {
            "type": "string",
            "default": "Book a 30-Minute Scoping Call"
        },
        "subtitle": {
            "type": "string",
            "default": "Strictly confidential under Bilateral NDA. We review your CUI boundary and timeline."
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "render": "file:./render.php",
    "editorScript": "secure-centric-editor-blocks"
}
