{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "secure-centric/form-embed",
    "version": "1.0.0",
    "title": "Forminator Lead Capture Embed",
    "category": "secure-centric-cta",
    "icon": "feedback",
    "description": "Embeds Forminator dual-email lead capture form with instant failover fallback.",
    "keywords": [
        "form",
        "forminator",
        "lead",
        "contact",
        "defense"
    ],
    "textdomain": "secure-centric",
    "attributes": {
        "formId": {
            "type": "string",
            "default": ""
        },
        "badgeText": {
            "type": "string",
            "default": "BILATERAL NDA GUARANTEE"
        },
        "title": {
            "type": "string",
            "default": "Book a 30-Minute Scoping Call"
        },
        "subtitle": {
            "type": "string",
            "default": "Strictly confidential under Bilateral NDA. We review your CUI boundary and timeline."
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "render": "file:./render.php",
    "editorScript": "secure-centric-editor-blocks"
}
