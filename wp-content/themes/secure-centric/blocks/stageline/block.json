    "title": { "type": "string", "default": "Where you fit" },
    "line": { "type": "string", "default": "You know CMMC applies but need clarity on scoping, timeline, and audit boundaries." },
    "processLink": { "type": "string", "default": "/secure-centric/cmmc/cmmc-process/" }
  },
  "supports": {
    "align": ["full", "wide"],
    "html": false
  },
  "render": "file:./render.php"
}