{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "secure-centric/stageline",
  "version": "1.0.0",
  "title": "Stage Line Bar",
  "category": "secure-centric-process",
  "icon": "flag",
  "description": "Displays where this engagement stage fits within the overall 8-step CMMC journey.",
  "keywords": ["stage", "process", "workflow", "banner"],
  "textdomain": "secure-centric",
  "attributes": {
    "stage": { "type": "string", "default": "Compliance Phase" },
