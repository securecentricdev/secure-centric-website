{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "secure-centric/testimonials",
    "version": "1.2.0",
    "title": "Defense Client Testimonials (Carousel & Grid)",
    "category": "secure-centric-proof",
    "icon": "format-quote",
    "description": "Infinite smooth testimonials carousel or static grid with verified LinkedIn badges. Add, remove, or customize any number of reviews.",
    "keywords": [
        "testimonials",
        "reviews",
        "carousel",
        "quotes",
        "defense"
    ],
    "textdomain": "secure-centric",
    "attributes": {
        "displayMode": {
            "type": "string",
            "default": "carousel"
        },
        "eyebrow": {
            "type": "string",
            "default": "// CLIENT TESTIMONIALS"
        },
        "title": {
            "type": "string",
            "default": "What Defense Contractors Say About Working With Us"
        },
        "subtitle": {
            "type": "string",
            "default": ""
        },
        "holdDelay": {
            "type": "number",
            "default": 3500
        },
        "testimonialsData": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ]
    },
    "render": "file:./render.php",
    "editorScript": "secure-centric-editor-blocks"
}
